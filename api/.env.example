# =========================
# API
# =========================
PORT=3000
API_PREFIX=api/v1
NODE_ENV=development

# Logging
LOG_LEVEL=info
LOG_DIR=../logs
NODE_ENV=development

# Sentry
SENTRY_DSN=https://****@******.ingest.us.sentry.io/*******
SENTRY_RELEASE=tms-api@0.0.1

# =========================
# Database
# =========================
DATABASE_URL=postgres://<user>:<password>@localhost:5432/<db_name>
PGSSL=false
PG_MAX_POOL=10

# =========================
# Frontend
# =========================
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Expiry for signed public notification links (WhatsApp "Details" links)
PUBLIC_LINK_EXPIRES_IN=30d

# =========================
# Google Authentication (Login)
# =========================
GOOGLE_CLIENT_ID=599434110877-...........apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-client-secret-placeholder>
GOOGLE_SCOPES=https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile https://mail.google.com/

# Google ? Backend OAuth callback
GOOGLE_REDIRECT_URI=http://localhost:3000/...../callback

# Backend ? Frontend redirect after login
AUTH_GOOGLE_REDIRECT=http://localhost:5173/......./callback

# =========================
# Google OAuth � Integrations (Drive / Sheets)
# =========================
GOOGLE_INTEGRATION_REDIRECT_URI=http://localhost:3000/api/....../callback
GOOGLE_SUCCESS_REDIRECT=http://localhost:5173/..../status

# =========================
# Google Drive � Team Folders
# =========================
GOOGLE_DRIVE_FOLDER_TEAM_1=1kE5ob....
GOOGLE_DRIVE_FOLDER_TEAM_2=1kE5ob....
GOOGLE_DRIVE_FOLDER_TEAM_7=1kE5ob....

# =========================
# OpenWA API KEY ("name":"TMS","role":"admin")
# =========================
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=owa_k1_.....
OPENWA_SESSION_ID=cc5d6d40-6335-****-9ba6-*****
OPENWA_WEBHOOK_SECRET=<openwa-webhook-secret-placeholder>

# =========================
# Auth / Security
# =========================
JWT_ACCESS_SECRET=<generate-with-openssl-rand-hex-32>
JWT_ACCESS_EXPIRATION=7d
JWT_REFRESH_SECRET=<generate-with-openssl-rand-hex-32>
JWT_REFRESH_EXPIRATION=14d

AUTH_STATE_SECRET=gyan-and-abhijeet-works-VEPL
STATE_SECRET=gyan-and-abhijeet-works-VEPL

# =========================
# Seed / Bootstrap
# =========================
SEED_ADMIN_EMAIL=gyan@volksenergie.in
SEED_ADMIN_PASSWORD=gyan_GYAN-1


# Development: MAIL_MODE=sandbox (never sends live mail)
# Production:  MAIL_MODE=production (sends live mail)
MAIL_MODE=production
MAIL_SANDBOX_TO=gyan@volksenergie.in
MAIL_SENDER_ID=13

FALLBACK_MAIL_USER_ID=13
FALLBACK_MAIL_USER_ID_GYAN=13

# Central mailbox user for courier request/status mails (defaults to 75)
COURIER_MAILBOX_USER_ID=75

# Notifications module (dev override): when NODE_ENV=development, all outgoing
# notifications (mail From/To + future WhatsApp) are redirected to this user id.
DEV_OVERRIDE_USER_ID=13

# =========================
# VolksAI PDF Extraction Microservice
# =========================
# Base URL for the volksAi FastAPI extraction service
VOLKS_AI_SERVICE_URL=http://localhost:8001
# Request timeout in milliseconds (120s covers full OCR + LLM fallback passes)
VOLKS_AI_TIMEOUT_MS=120000

# Auto-enqueue checklist analysis upon successful infosheet extraction (default: false)
AUTO_ENQUEUE_CHECKLIST_ANALYSIS=false
# =========================
# =========================
# Currency conversion (System Health Claude cost dashboard, display only)
# =========================
# USD -> INR rate used ONLY to display Claude token usage cost in INR.
# claude_token_usage always stores cost in USD (source of truth, never
# overwritten) -- this is a display-time conversion. This is a manually
# set snapshot, NOT a live rate: update it periodically.
USD_TO_INR_RATE=94.83
# Date the rate above was last checked/updated (shown on the dashboard so a
# stale rate is never mistaken for a live one).
USD_TO_INR_RATE_AS_OF=2026-09-08
