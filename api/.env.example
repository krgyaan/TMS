# Voucher week bucketing cutover (YYYY-MM-DD, IST).
# Historic vouchers (before this date) were bucketed to the week of their
# MIN(effective_date) (valid_from may be mid-week). From this date onward
# every voucher is created with an ISO Monday boundary via isoWeekBounds and
# the list query buckets new weeks to Monday so they match the stored rows.
VOUCHER_MONDAY_CUTOVER=2026-08-01

# Notifications module (dev override): when NODE_ENV=development, all outgoing
# notifications (mail From/To + future WhatsApp) are redirected to this user id.
DEV_OVERRIDE_USER_ID=13