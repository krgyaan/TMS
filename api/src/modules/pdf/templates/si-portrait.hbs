<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Tax Invoice - {{invoice_number}}</title>
    <style>
        @page {
            size: A4 portrait;
            margin: 8mm;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
        }

        body {
            background: #fff;
            color: #111;
            font-family: Arial, sans-serif;
            font-size: 8px;
        }

        .wm {
            position: fixed;
            left: 50%;
            top: 50%;
            width: 150mm;
            transform: translate(-50%, -50%);
            z-index: -1;
            pointer-events: none;
        }

        .page {
            width: 194mm;
            margin: 0 auto;
            position: relative;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        td,
        th {
            border: 1px solid #222;
            padding: 2px;
            vertical-align: top;
            overflow-wrap: anywhere;
        }

        .noborder,
        .noborder td {
            border: 0;
        }

        table.cb {
            font-size: 8px;
            line-height: 1.25;
            margin-bottom: -1px;
        }

        table.cb td,
        table.cb th {
            padding: 2px 3px;
        }

        table.items>thead {
            display: table-header-group;
        }

        table.items>tbody>tr>td.blk,
        table.items>thead>tr>td.blk {
            border: 0;
            padding: 0;
        }

        table.items tr {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .keep-together {
            break-inside: avoid;
            page-break-inside: avoid;
        }
    </style>
</head>

<body>
    <img class="wm" alt="" src="data:image/png;base64,{{img_logo_base64}}">
    <div class="page">

        <div style="position:relative;min-height:30mm;">
            <div style="text-align:center;font-size:12px;font-weight:bold;padding-bottom:5mm;">Tax Invoice</div>

            {{#if qr_code_base64}}
            <div style="position:absolute;top:0;right:0;width:28mm;height:28mm;">
                <img alt="Invoice QR code" src="data:image/png;base64,{{qr_code_base64}}"
                    style="width:100%;height:100%;object-fit:contain;">
            </div>
            {{/if}}

            <table class="noborder" style="width:162mm;margin-bottom:3mm;">
                {{#if irn}}
                <tr>
                    <td style="width:16mm;padding:1px 0;">IRN</td>
                    <td style="font-weight:bold;padding:1px 0;word-break:break-all;">{{irn}}</td>
                </tr>
                {{/if}}
                {{#if ack_number}}
                <tr>
                    <td style="padding:1px 0;">Ack No.</td>
                    <td style="font-weight:bold;padding:1px 0;">{{ack_number}}</td>
                </tr>
                {{/if}}
                {{#if ack_date}}
                <tr>
                    <td style="padding:1px 0;">Ack Date</td>
                    <td style="font-weight:bold;padding:1px 0;">{{formatDate ack_date}}</td>
                </tr>
                {{/if}}
            </table>
        </div>

        <table class="items" style="font-size:8px;line-height:1.3;">
            <colgroup>
                {{#if is_interstate}}
                <col style="width:4%">
                <col style="width:25%">
                <col style="width:8%">
                <col style="width:6%">
                <col style="width:10%">
                <col style="width:4%">
                <col style="width:4%">
                <col style="width:12%">
                <col style="width:6%">
                <col style="width:10%">
                <col style="width:11%">
                {{else}}
                <col style="width:3%">
                <col style="width:25%">
                <col style="width:6%">
                <col style="width:5%">
                <col style="width:7%">
                <col style="width:3%">
                <col style="width:3%">
                <col style="width:10%">
                <col style="width:5%">
                <col style="width:7%">
                <col style="width:5%">
                <col style="width:7%">
                <col style="width:14%">
                {{/if}}
            </colgroup>
            <thead>
                <tr>
                    <td class="blk" colspan="{{#if is_interstate}}11{{else}}13{{/if}}">
                        <table class="cb">
                            <colgroup>
                                <col style="width:20.7%">
                                <col style="width:9.9%">
                                <col style="width:19.9%">
                                <col style="width:16.9%">
                                <col style="width:8.5%">
                                <col style="width:24.1%">
                            </colgroup>
                            <tr>
                                <td rowspan="2" style="text-align:center;vertical-align:middle;">
                                    <img src="data:image/png;base64,{{img_logo_base64}}" alt="Volks Energie"
                                        style="width:100%;max-height:14mm;object-fit:contain;">
                                </td>
                                <td rowspan="2" colspan="2">
                                    <b>Volks Energie Private Limited</b><br>
                                    B-1, D-8, 2nd Floor,<br>
                                    Mohan Cooperative Industrial Estate,<br>
                                    New Delhi Delhi - 110044<br>
                                    UDYAM : <b>UDYAM-DL-09-000465 (small)</b><br>
                                    GSTIN/UIN: <b>07AADCV9396C1ZZ</b><br>
                                    State Name: <b>Delhi</b>, Code: <b>07</b><br>
                                    CIN: <b>U40100DL2011PTC228907</b>
                                </td>
                                <td colspan="2">Invoice No<br><b>{{invoice_number}}</b></td>
                                <td>Dated<br><b>{{formatDate invoice_date}}</b></td>
                            </tr>
                            <tr>
                                <td colspan="2">Buyer's Order No.<br><b>{{buyer_order_number}}</b></td>
                                <td>Dated<br><b>{{formatDate buyer_order_date}}</b></td>
                            </tr>
                            <tr>
                                <td>
                                    Transporter Name<br>
                                    Transporter GST No<br>
                                    Transport Via<br>
                                    Bill of Lading/LR-RR No<br>
                                    Motor Vehicle No.
                                </td>
                                <td colspan="2">
                                    {{transporter_name}}<br>
                                    {{transporter_gst}}<br>
                                    {{transporter_mode}}<br>
                                    {{bill_of_lading_number}}<br>
                                    {{vehicle_number}}
                                </td>
                                <td colspan="2">
                                    VE Project Code<br>
                                    Project Manager<br>
                                    Phone Number<br>
                                    Email Id
                                </td>
                                <td>
                                    {{project_code}}<br>
                                    {{project_manager}}<br>
                                    {{project_manager_phone}}<br>
                                    {{project_manager_email}}
                                </td>
                            </tr>
                            <tr>
                                <th colspan="2" style="text-align:center;">Buyer (Bill to)</th>
                                <th colspan="2" style="text-align:center;">Consignee (Ship to)</th>
                                <th colspan="2" style="text-align:center;">Dispatch From</th>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <b>{{buyer_name}}</b><br>
                                    <pre
                                        style="white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;margin:0;">{{buyer_address}}</pre>
                                    {{#if buyer_pin}}Pin Code: {{buyer_pin}}<br>{{/if}}
                                    GSTIN/UIN: {{buyer_gst}}<br>
                                    PAN/IT No: {{buyer_pan}}<br>
                                    State Name: {{buyer_state}}<br>
                                    Contact Person: {{buyer_contact_person}}<br>
                                    Phone No: {{buyer_phone}}
                                </td>
                                <td colspan="2">
                                    <b>{{consignee_name}}</b><br>
                                    <pre
                                        style="white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;margin:0;">{{consignee_address}}</pre>
                                    {{#if consignee_pin}}Pin Code: {{consignee_pin}}<br>{{/if}}
                                    GSTIN/UIN: {{consignee_gst}}<br>
                                    PAN/IT No: {{consignee_pan}}<br>
                                    State Name: {{consignee_state}}<br>
                                    Contact Person: {{consignee_contact_person}}<br>
                                    Phone No: {{consignee_phone}}
                                </td>
                                <td colspan="2">
                                    <b>{{dispatch_from_name}}</b><br>
                                    <pre
                                        style="white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;margin:0;">{{dispatch_address}}</pre>
                                    {{#if dispatch_pin}}Pin Code: {{dispatch_pin}}<br>{{/if}}
                                    GSTIN/UIN: {{dispatch_gst}}<br>
                                    PAN/IT No: {{dispatch_pan}}<br>
                                    State Name: {{dispatch_state}}<br>
                                    Contact Person: {{dispatch_contact_person}}<br>
                                    Phone No: {{dispatch_phone}}
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <th rowspan="2" style="padding:3px;">Sl.<br>No.</th>
                    <th rowspan="2" style="padding:3px;">Description of Goods</th>
                    <th rowspan="2" style="padding:3px;">HSN/SAC</th>
                    <th rowspan="2" style="padding:3px;">Qty</th>
                    <th rowspan="2" style="padding:3px;">Rate</th>
                    <th rowspan="2" style="padding:3px;">Per</th>
                    <th rowspan="2" style="padding:3px;">Disc. %</th>
                    <th rowspan="2" style="padding:3px;">Taxable Value</th>
                    {{#if is_interstate}}
                    <th colspan="2" style="padding:3px;">IGST</th>
                    {{else}}
                    <th colspan="2" style="padding:3px;">CGST</th>
                    <th colspan="2" style="padding:3px;">SGST</th>
                    {{/if}}
                    <th rowspan="2" style="padding:3px;">Total Amount</th>
                </tr>
                <tr>
                    {{#if is_interstate}}
                    <th style="padding:3px;">Rate</th>
                    <th style="padding:3px;">Amount</th>
                    {{else}}
                    <th style="padding:3px;">Rate</th>
                    <th style="padding:3px;">Amount</th>
                    <th style="padding:3px;">Rate</th>
                    <th style="padding:3px;">Amount</th>
                    {{/if}}
                </tr>
            </thead>
            <tbody>

                {{#each items}}
                <tr style="height:14mm;">
                    <td>{{inc @index}}</td>
                    <td>
                        {{#if this.boq_item_name}}
                        <b>{{this.boq_item_name}}</b><br>
                        {{this.po_item_description}}
                        {{else}}
                        <b>{{this.po_item_description}}</b>
                        {{/if}}
                    </td>
                    <td>{{this.hsn_sac}}</td>
                    <td style="text-align:right;"><b>{{this.quantity}}</b></td>
                    <td style="text-align:right;">{{formatCurrency this.rate}}</td>
                    <td style="text-align:center;">{{this.unit}}</td>
                    <td style="text-align:center;">{{this.discount_percent}}%</td>
                    <td style="text-align:right;"><b>{{formatCurrency this.taxable_value}}</b></td>
                    {{#if ../is_interstate}}
                    <td style="text-align:center;">{{this.igst_rate}}%</td>
                    <td style="text-align:right;"><b>{{formatCurrency this.igst_amount}}</b></td>
                    {{else}}
                    <td style="text-align:center;">{{this.cgst_rate}}%</td>
                    <td style="text-align:right;"><b>{{formatCurrency this.cgst_amount}}</b></td>
                    <td style="text-align:center;">{{this.sgst_rate}}%</td>
                    <td style="text-align:right;"><b>{{formatCurrency this.sgst_amount}}</b></td>
                    {{/if}}
                    <td style="text-align:right;"><b>{{formatCurrency this.total}}</b></td>
                </tr>
                {{/each}}

                <tr>
                    <td class="blk" colspan="{{#if is_interstate}}11{{else}}13{{/if}}">
                        <div class="keep-together">
                            <table style="font-size:8px;line-height:1.3;margin-top:-1px;">
                                <colgroup>
                                    {{#if is_interstate}}
                                    <col style="width:4%">
                                    <col style="width:25%">
                                    <col style="width:8%">
                                    <col style="width:6%">
                                    <col style="width:10%">
                                    <col style="width:4%">
                                    <col style="width:4%">
                                    <col style="width:12%">
                                    <col style="width:6%">
                                    <col style="width:10%">
                                    <col style="width:11%">
                                    {{else}}
                                    <col style="width:3%">
                                    <col style="width:25%">
                                    <col style="width:6%">
                                    <col style="width:5%">
                                    <col style="width:7%">
                                    <col style="width:3%">
                                    <col style="width:3%">
                                    <col style="width:10%">
                                    <col style="width:5%">
                                    <col style="width:7%">
                                    <col style="width:5%">
                                    <col style="width:7%">
                                    <col style="width:14%">
                                    {{/if}}
                                </colgroup>
                                <tr>
                                    <td colspan="7" style="text-align:right;"><b>Line Item Subtotal</b></td>
                                    <td style="text-align:right;">{{formatCurrency line_item_subtotal}}</td>
                                    {{#if is_interstate}}
                                    <td></td>
                                    <td style="text-align:right;">{{formatCurrency igst_amount}}</td>
                                    {{else}}
                                    <td></td>
                                    <td style="text-align:right;">{{formatCurrency cgst_amount}}</td>
                                    <td></td>
                                    <td style="text-align:right;">{{formatCurrency sgst_amount}}</td>
                                    {{/if}}
                                    <td style="text-align:right;">{{formatCurrency taxable_value}}</td>
                                </tr>

                                {{#if freight}}
                                <tr>
                                    <td colspan="7" style="text-align:right;">Freight</td>
                                    <td style="text-align:right;">{{formatCurrency freight}}</td>
                                    <td colspan="{{#if is_interstate}}2{{else}}4{{/if}}"></td>
                                    <td style="text-align:right;">{{formatCurrency freight}}</td>
                                </tr>
                                {{/if}}

                                {{#if other_charges}}
                                <tr>
                                    <td colspan="7" style="text-align:right;">Other Charges</td>
                                    <td style="text-align:right;">{{formatCurrency other_charges}}</td>
                                    <td colspan="{{#if is_interstate}}2{{else}}4{{/if}}"></td>
                                    <td style="text-align:right;">{{formatCurrency other_charges}}</td>
                                </tr>
                                {{/if}}

                                {{#if round_off}}
                                <tr>
                                    <td colspan="7" style="text-align:right;">Round Off</td>
                                    <td style="text-align:right;">{{formatCurrency round_off}}</td>
                                    <td colspan="{{#if is_interstate}}2{{else}}4{{/if}}"></td>
                                    <td style="text-align:right;">{{formatCurrency round_off}}</td>
                                </tr>
                                {{/if}}

                                <tr>
                                    <td colspan="7" style="text-align:right;"><b>Grand Total</b></td>
                                    <td style="text-align:right;"><b>{{formatCurrency taxable_value}}</b></td>
                                    {{#if is_interstate}}
                                    <td></td>
                                    <td style="text-align:right;">{{formatCurrency igst_amount}}</td>
                                    {{else}}
                                    <td></td>
                                    <td style="text-align:right;">{{formatCurrency cgst_amount}}</td>
                                    <td></td>
                                    <td style="text-align:right;">{{formatCurrency sgst_amount}}</td>
                                    {{/if}}
                                    <td style="text-align:right;"><b>{{formatCurrency grand_total}}</b></td>
                                </tr>
                                <tr>
                                    <td colspan="{{#if is_interstate}}10{{else}}11{{/if}}">
                                        Amount Chargeable (in words): <b>{{amount_in_words}}</b>
                                    </td>
                                    <td style="text-align:right;" colspan="{{#if is_interstate}}1{{else}}2{{/if}}">E
                                        &amp; O.E.</td>
                                </tr>
                            </table>

                            <table style="margin-top:-1px;font-size:8px;">
                                <colgroup>
                                    <col style="width:16.66%">
                                    <col style="width:16.66%">
                                    <col style="width:16.66%">
                                    <col style="width:16.66%">
                                    <col style="width:16.66%">
                                    <col style="width:16.7%">
                                </colgroup>
                                <tr>
                                    <th style="padding:3px;">GST Rate</th>
                                    <th style="padding:3px;">Taxable Value</th>
                                    <th style="padding:3px;">IGST</th>
                                    <th style="padding:3px;">CGST</th>
                                    <th style="padding:3px;">SGST</th>
                                    <th style="padding:3px;">Total Tax</th>
                                </tr>
                                {{#each tax_breakdown}}
                                <tr>
                                    <td style="text-align:right;">{{rate}}%</td>
                                    <td style="text-align:right;">{{formatCurrency taxable_value}}</td>
                                    <td style="text-align:right;">{{#if ../is_interstate}}{{formatCurrency
                                        igst_amount}}{{/if}}</td>
                                    <td style="text-align:right;">{{#unless ../is_interstate}}{{formatCurrency
                                        cgst_amount}}{{/unless}}</td>
                                    <td style="text-align:right;">{{#unless ../is_interstate}}{{formatCurrency
                                        sgst_amount}}{{/unless}}</td>
                                    <td style="text-align:right;">{{formatCurrency tax_amount}}</td>
                                </tr>
                                {{/each}}
                                <tr>
                                    <td colspan="5" style="text-align:right;"><b>Total Tax</b></td>
                                    <td style="text-align:right;"><b>{{formatCurrency total_tax_amount}}</b></td>
                                </tr>
                            </table>

                            <table style="margin-top:-1px;font-size:8px;line-height:1.45;">
                                <tr>
                                    <td colspan="3" style="padding:3px;">
                                        Tax Amount (in words): <b>{{tax_amount_in_words}}</b>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width:50%;padding:3px;">
                                        <u>Declaration</u><br>
                                        We declare that this invoice shows the actual price of the goods described and
                                        that all particulars are true and correct.
                                    </td>
                                    <td style="width:50%;padding:3px;" colspan="2">
                                        Company's PAN: <b>AADCV9396C</b><br>
                                        Company's Bank Details:<br>
                                        Bank Name: <b>Au Small Finance Bank Ltd (CC A/c No. 5180) - Inflow</b><br>
                                        A/c No.: <b>2506245699295180</b><br>
                                        Branch &amp; IFS Code: <b>Lajpat Nagar, New Delhi &amp; AUBL0002456</b><br>
                                        SWIFT Code: <b>-</b>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width:34%;padding:3px;height:19mm;">
                                        Prepared by<br><br>
                                        <b>{{prepared_by_name}}</b><br>
                                        {{prepared_by_email}}<br>
                                        {{prepared_by_phone}}
                                    </td>
                                    <td style="width:33%;padding:3px;">
                                        Approved by<br><br>
                                        <b>{{approved_by_name}}</b><br>
                                        {{approved_by_email}}<br>
                                        {{approved_by_phone}}
                                    </td>
                                    <td style="width:33%;padding:3px;text-align:right;">
                                        <b>for {{seller_name}}</b>
                                        <div style="height:12mm;"></div>
                                        Authorised Signatory
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>

    </div>
</body>

</html>