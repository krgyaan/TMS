        /* ---- Page chrome (letterhead / footer / watermark) ---- */
        body {
            margin: 0;
            padding: 0;
            color: #000000;
        }

        .page {
            padding: 0 40px 24mm 40px;
        }

        .footer {
            position: fixed;
            bottom: 6mm;
            left: 0;
            width: 100%;
            background: #fff;
        }

        .footer-line {
            width: 100%;
            height: 2px;
            background: #000;
        }

        .footer-content {
            padding: 8px 10px;
        }

        .wm {
            position: fixed;
            left: 50%;
            top: 50%;
            width: 150mm;
            transform: translate(-50%, -50%);
            z-index: -1;
            opacity: 0.1;
            pointer-events: none;
        }

        .page-break {
            page-break-before: always;
        }

