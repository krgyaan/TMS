<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AU Small Finance Bank – Term Deposit Form</title>
    <style>
        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            background: #e9e9e9;
            font-family: Arial, sans-serif
        }

        .toolbar {
            position: sticky;
            top: 0;
            z-index: 5;
            background: #fff;
            padding: 10px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 1px 5px #0002
        }

        .toolbar button {
            background: #68166f;
            color: #fff;
            border: 0;
            border-radius: 4px;
            padding: 9px 14px;
            cursor: pointer
        }

        .hint {
            font-size: 13px;
            color: #555
        }

        .pages {
            padding: 16px 0
        }

        .page {
            position: relative;
            width: min(100%, 210mm);
            aspect-ratio: 1489 / 2105;
            margin: 0 auto 18px;
            background-size: 100% 100%;
            background-repeat: no-repeat;
            box-shadow: 0 2px 12px #0003;
            overflow: hidden
        }

        .page1 {
            background-image: url("data:image/png;base64,")
        }

        .page2 {
            background-image: url("data:image/png;base64,")
        }

        .field {
            position: absolute;
            display: flex;
            align-items: stretch;
            gap: 0;
            height: 1.05%;
        }

        .field input {
            min-width: 0;
            width: 100%;
            height: 100%;
            padding: 0 1px;
            border: 0;
            border-radius: 0;
            background: transparent;
            color: #17110f;
            font: 600 9px Arial, sans-serif;
            text-align: center;
            outline: none
        }

        .boxes input {
            border: 0;
            border-radius: 0;
            padding: 0;
            text-align: center;
            min-width: 0;
            flex: 1;
            background: transparent;
            line-height: 1
        }

        .boxes input:focus {
            background: #fff9;
            border-color: #68166f
        }

        .boxes .dash {
            width: 5%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            color: #333
        }
        .line input {
            text-align: left;
            padding-left: 3px;
            border: 0
        }

        .date-top {
            left: 5.65%;
            top: 6.52%;
            width: 15.05%;
            height: 1.7%
        }

        .branch {
            left: 86.25%;
            top: 7.10%;
            width: 11.35%;
            height: .72%
        }

        .amount {
            left: 14.35%;
            top: 26.45%;
            width: 23.0%;
            height: 1.65%
        }

        .amount-words {
            left: 51.2%;
            top: 26.5%;
            width: 46%;
            height: 1.2%
        }

        .debit {
            left: 43.15%;
            top: 28.9%;
            width: 30.5%;
            height: 1.8%
        }

        .dated {
            left: 29.3%;
            top: 30.70%;
            width: 11.65%;
            height: 1.6%
        }

        .duration-months {
            left: 20.9%;
            top: 34.2%;
            width: 4.05%;
            height: 1.55%
        }

        .duration-days {
            left: 31.45%;
            top: 34.2%;
            width: 4.05%;
            height: 1.55%
        }

        @page {
            size: A4 portrait;
            margin: 0
        }

        @media print {
            body {
                background: #fff
            }

            .toolbar {
                display: none
            }

            .pages {
                padding: 0
            }

            .page {
                width: 210mm;
                height: 297mm;
                margin: 0;
                box-shadow: none;
                page-break-after: always;
                break-after: page
            }

            .page:last-child {
                page-break-after: auto;
                break-after: auto
            }
        }

        @media screen and (max-width:700px) {
            .hint {
                display: none
            }

            .page {
                width: 100%;
                margin-bottom: 10px
            }
        }
    </style>
</head>

<body>
    <div class="pages">
        <section class="page page1" aria-label="Page 1 - Term Deposit Form">
            <!-- Deposit date: eight character boxes -->
            <div class="field boxes date-top" aria-label="Deposit date">{{#each dateDigits}}<input type="text" value="{{this}}" readonly>{{/each}}</div>
            <!-- Branch name is a single underline field -->
            <label class="field line branch"><input type="text" value="{{branchName}}" readonly></label>
            <!-- INR amount: nine digit boxes, hyphen, two decimal boxes -->
            <div class="field boxes amount" aria-label="Amount in INR">{{#each amountRupeeDigits}}<input type="text" value="{{this}}" readonly>{{/each}}<span class="dash">-</span>{{#each amountPaiseDigits}}<input type="text" value="{{this}}" readonly>{{/each}}</div>
            <label class="field line amount-words"><input type="text" value="{{amountWords}}" readonly></label>
            <!-- Debit account number: sixteen separate boxes -->
            <div class="field boxes debit" aria-label="Debit my account number">{{#each debitDigits}}<input type="text" value="{{this}}" readonly>{{/each}}</div>
            <!-- Dated: eight boxes -->
            <div class="field boxes dated" aria-label="Dated">{{#each datedDigits}}<input type="text" value="{{this}}" readonly>{{/each}}</div>
            <!-- Duration: two month boxes and two day boxes -->
            <div class="field boxes duration-months" aria-label="Duration in months">{{#each durationMonthDigits}}<input type="text" value="{{this}}" readonly>{{/each}}</div>
            <div class="field boxes duration-days" aria-label="Duration in days">{{#each durationDayDigits}}<input type="text" value="{{this}}" readonly>{{/each}}</div>
        </section>
        <section class="page page2" aria-label="Page 2 - Nomination Details"></section>
    </div>
</body>

</html>