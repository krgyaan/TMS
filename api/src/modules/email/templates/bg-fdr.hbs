<div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.6; color: #222; max-width: 640px;">
    <p><strong>Dear Sir,</strong></p>

    <p>The following Bank guarantee has been issued for your organization.</p>

    <table cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
        {{#if data.referenceValue}}
        <tr>
            <td style="width:200px; padding:2px 0; text-align:left; font-weight:bold; white-space:nowrap; vertical-align:top;"><strong>{{data.referenceLabel}}</strong></td>
            <td style="width:8px; padding:2px 0; text-align:left; font-weight:bold; vertical-align:top;"><strong>:</strong></td>
            <td style="padding:2px 0 2px 10px; text-align:left; vertical-align:top;">{{data.referenceValue}}</td>
        </tr>
        {{#if data.referenceDate}}
        <tr>
            <td style="width:200px; padding:2px 0; text-align:left; font-weight:bold; white-space:nowrap; vertical-align:top;"><strong>WO/Tender Date</strong></td>
            <td style="width:8px; padding:2px 0; text-align:left; font-weight:bold; vertical-align:top;"><strong>:</strong></td>
            <td style="padding:2px 0 2px 10px; text-align:left; vertical-align:top;">{{data.referenceDate}}</td>
        </tr>
        {{/if}}
        {{/if}}
        {{#if data.bgNo}}
        <tr>
            <td style="width:200px; padding:2px 0; text-align:left; font-weight:bold; white-space:nowrap; vertical-align:top;"><strong>BG No.</strong></td>
            <td style="width:8px; padding:2px 0; text-align:left; font-weight:bold; vertical-align:top;"><strong>:</strong></td>
            <td style="padding:2px 0 2px 10px; text-align:left; vertical-align:top;">{{data.bgNo}}</td>
        </tr>
        {{/if}}
        {{#if data.bgExpiryDate}}
        <tr>
            <td style="width:200px; padding:2px 0; text-align:left; font-weight:bold; white-space:nowrap; vertical-align:top;"><strong>BG Expiry Date</strong></td>
            <td style="width:8px; padding:2px 0; text-align:left; font-weight:bold; vertical-align:top;"><strong>:</strong></td>
            <td style="padding:2px 0 2px 10px; text-align:left; vertical-align:top;">{{data.bgExpiryDate}}</td>
        </tr>
        {{/if}}
        {{#if data.bgClaimDate}}
        <tr>
            <td style="width:200px; padding:2px 0; text-align:left; font-weight:bold; white-space:nowrap; vertical-align:top;"><strong>BG Claim Date</strong></td>
            <td style="width:8px; padding:2px 0; text-align:left; font-weight:bold; vertical-align:top;"><strong>:</strong></td>
            <td style="padding:2px 0 2px 10px; text-align:left; vertical-align:top;">{{data.bgClaimDate}}</td>
        </tr>
        {{/if}}
        {{#if data.beneficiaryName}}
        <tr>
            <td style="width:200px; padding:2px 0; text-align:left; font-weight:bold; white-space:nowrap; vertical-align:top;"><strong>BG in favor of</strong></td>
            <td style="width:8px; padding:2px 0; text-align:left; font-weight:bold; vertical-align:top;"><strong>:</strong></td>
            <td style="padding:2px 0 2px 10px; text-align:left; vertical-align:top;">{{data.beneficiaryName}}</td>
        </tr>
        {{/if}}
        {{#if data.amount}}
        <tr>
            <td style="width:200px; padding:2px 0; text-align:left; font-weight:bold; white-space:nowrap; vertical-align:top;"><strong>Amount</strong></td>
            <td style="width:8px; padding:2px 0; text-align:left; font-weight:bold; vertical-align:top;"><strong>:</strong></td>
            <td style="padding:2px 0 2px 10px; text-align:left; vertical-align:top;">Rs. {{data.amount}}</td>
        </tr>
        {{/if}}
        {{#if data.stampPaperValue}}
        <tr>
            <td style="width:200px; padding:2px 0; text-align:left; font-weight:bold; white-space:nowrap; vertical-align:top;"><strong>BG Stamp paper value</strong></td>
            <td style="width:8px; padding:2px 0; text-align:left; font-weight:bold; vertical-align:top;"><strong>:</strong></td>
            <td style="padding:2px 0 2px 10px; text-align:left; vertical-align:top;">Rs. {{data.stampPaperValue}}</td>
        </tr>
        {{/if}}
    </table>

    <div style="height:14pt; line-height:14pt;">&nbsp;</div>

    <table cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
        {{#if data.hasCoveringLetter}}
        <tr>
            <td style="width:200px; padding:2px 0; text-align:left; font-weight:bold; white-space:nowrap; vertical-align:top;"><strong>Covering Letter</strong></td>
            <td style="width:8px; padding:2px 0; text-align:left; font-weight:bold; vertical-align:top;"><strong>:</strong></td>
            <td style="padding:2px 0 2px 10px; text-align:left; vertical-align:top;">attached</td>
        </tr>
        {{/if}}
        {{#if data.hasSoftCopy}}
        <tr>
            <td style="width:200px; padding:2px 0; text-align:left; font-weight:bold; white-space:nowrap; vertical-align:top;"><strong>Soft copy of the BG</strong></td>
            <td style="width:8px; padding:2px 0; text-align:left; font-weight:bold; vertical-align:top;"><strong>:</strong></td>
            <td style="padding:2px 0 2px 10px; text-align:left; vertical-align:top;">attached</td>
        </tr>
        {{/if}}
        {{#if data.courierProvider}}
        <tr>
            <td style="width:200px; padding:2px 0; text-align:left; font-weight:bold; white-space:nowrap; vertical-align:top;"><strong>Courier Provider</strong></td>
            <td style="width:8px; padding:2px 0; text-align:left; font-weight:bold; vertical-align:top;"><strong>:</strong></td>
            <td style="padding:2px 0 2px 10px; text-align:left; vertical-align:top;">{{data.courierProvider}}</td>
        </tr>
        {{/if}}
        {{#if data.courierDocketNo}}
        <tr>
            <td style="width:200px; padding:2px 0; text-align:left; font-weight:bold; white-space:nowrap; vertical-align:top;"><strong>Courier Docket no.</strong></td>
            <td style="width:8px; padding:2px 0; text-align:left; font-weight:bold; vertical-align:top;"><strong>:</strong></td>
            <td style="padding:2px 0 2px 10px; text-align:left; vertical-align:top;">{{data.courierDocketNo}}</td>
        </tr>
        {{/if}}
        {{#if data.hasDocketSlip}}
        <tr>
            <td style="width:200px; padding:2px 0; text-align:left; font-weight:bold; white-space:nowrap; vertical-align:top;"><strong>Courier Docket Slip</strong></td>
            <td style="width:8px; padding:2px 0; text-align:left; font-weight:bold; vertical-align:top;"><strong>:</strong></td>
            <td style="padding:2px 0 2px 10px; text-align:left; vertical-align:top;">attached</td>
        </tr>
        {{/if}}
        {{#if data.hasSfmsConf}}
        <tr>
            <td style="width:200px; padding:2px 0; text-align:left; font-weight:bold; white-space:nowrap; vertical-align:top;"><strong>SFMS Confirmation</strong></td>
            <td style="width:8px; padding:2px 0; text-align:left; font-weight:bold; vertical-align:top;"><strong>:</strong></td>
            <td style="padding:2px 0 2px 10px; text-align:left; vertical-align:top;">attached</td>
        </tr>
        {{/if}}
    </table>

    <p style="margin:14pt 0;">Please track the BG and confirm receipt of the BG and the SFMS confirmation via a reply to this email.</p>

    <p>
        Regards,<br>
        Imran Khan,<br>
        +91-88825-91733<br>
        Accounts team,<br>
        Volks Energie Pvt. Ltd.
    </p>
</div>
