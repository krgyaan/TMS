      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ]
  },
  "logo": {
    "light": "/tms-docs/images/dark-ve-logo.png",
    "dark": "/tms-docs/images/ve_logo.png"
  },
  "icons": {
    "library": "fontawesome"
  },
  "background": {
    "decoration": "grid"
  },
  "fonts": {
    "family": "Geist"
  },
  "contextual": {
    "options": [
      "download-pdf",
