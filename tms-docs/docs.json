{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Tender Management System",
  "colors": {
    "primary": "#FF6900",
    "light": "#FF8A3D",
    "dark": "#D94F00"
  },
  "favicon": {
    "light": "/images/ve_favicon.png",
    "dark": "/images/ve_favicon.png"
  },
  "logo": {
    "light": "/images/dark-ve-logo.png",
    "dark": "/images/ve_logo.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Overview",
        "pages": [
          "index",
          "quickstart",
          "onboarding"
        ]
      },
      {
        "group": "Architecture & Flow",
        "pages": [
          "architecture/overview",
          "architecture/repo-map",
          "architecture/end-to-end-flow"
        ]
      },
      {
        "group": "VolksAI Intelligence",
        "pages": [
          "volksai/overview",
          "volksai/handoff-guide",
          "volksai/two-layer-extraction",
          "volksai/llm-roles-and-prompts",
          "volksai/checklists-and-requirements",
          "volksai/ocr-and-scanned-documents",
          "volksai/ground-truth-and-testing"
        ]
      },
      {
        "group": "Backend & Database",
        "pages": [
          "backend/overview",
          "backend/database-and-schemas",
          "backend/workers-and-queues"
        ]
      },
      {
        "group": "Frontend",
        "pages": [
          "frontend/overview",
          "frontend/tendering-ui"
        ]
      },
      {
        "group": "Operations & DevOps",
        "pages": [
          "devops/configuration",
          "devops/monitoring-and-logging",
          "devops/testing-and-debugging"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/status-and-issues",
          "reference/scope-and-roadmap",
          "reference/glossary"
        ]
      }
    ]
  },
  "icons": {
    "library": "fontawesome"
  },
  "background": {
    "decoration": "grid"
  },
  "fonts": {
    "family": "Geist"
  },
  "contextual": {
    "options": [
      "download-pdf",
      "chatgpt",
      "claude"
