{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Tender Management System",
  "colors": {
    "primary": "#FF6900",
    "light": "#FF8A3D",
    "dark": "#D94F00"
  },
  "favicon": {
    "light": "/tms-docs/images/logo.svg",
    "dark": "/tms-docs/images/logo.svg"
  },
  "navigation": {
