{
  "name": "@mintlify/models",
  "version": "0.0.379",
  "description": "Mintlify models",
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Mintlify, Inc.",
  "bugs": {
    "url": "https://github.com/mintlify/docs/issues"
  },
  "license": "Elastic-2.0",
  "keywords": [
    "mintlify",
    "mint",
    "models"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mintlify/mint",
    "directory": "packages/models"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc",
    "clean:build": "rimraf dist",
    "clean:all": "rimraf node_modules .eslintcache && pnpm clean:build",
    "watch": "tsc --watch",
    "format": "oxfmt \"./src/**/*.ts\"",
    "format:check": "oxfmt --check \"./src/**/*.ts\"",
    "lint": "oxlint src",
    "type": "tsgo --noEmit"
  },
  "dependencies": {
    "axios": "1.18.0",
    "openapi-types": "12.1.3"
  },
  "devDependencies": {
    "@mintlify/ts-config": "2.0.2",
    "@tsconfig/recommended": "1.0.2",
    "@types/node": "18.19.21",
    "oxfmt": "^0.51.0",
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "rimraf": "5.0.1",
    "typescript": "5.5.3"
  },
  "gitHead": "8633bf3a3df756b5de637bf2c452093f5e397a6d"
}
