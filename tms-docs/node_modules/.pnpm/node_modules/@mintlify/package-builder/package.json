{
  "name": "@mintlify/package-builder",
  "version": "0.0.99",
  "description": "Installs, bundles and server-renders npm package islands for Mintlify docs",
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Mintlify, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mintlify/mint",
    "directory": "packages/package-builder"
  },
  "bugs": {
    "url": "https://github.com/mintlify/mint/issues"
  },
  "license": "Elastic-2.0",
  "keywords": [
    "mintlify",
    "mint",
    "npm",
    "islands"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hashing": {
      "types": "./dist/hashing.d.ts",
      "default": "./dist/hashing.js"
    },
    "./limits": {
      "types": "./dist/limits.d.ts",
      "default": "./dist/limits.js"
    },
    "./sanitize": {
      "types": "./dist/sanitize.d.ts",
      "default": "./dist/sanitize.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "bin": {
    "mint-package-builder": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc --project tsconfig.build.json",
    "clean:build": "rimraf dist",
    "clean:all": "rimraf node_modules .eslintcache && pnpm clean:build",
    "watch": "tsc --project tsconfig.build.json --watch",
    "test": "vitest run",
    "type": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "entities": "7.0.1",
    "esbuild": "0.25.12",
    "js-yaml": "4.3.1",
    "semver": "7.7.4"
  },
  "devDependencies": {
    "@mintlify/common": "1.0.1310",
    "@mintlify/ts-config": "2.0.2",
    "@mintlify/validation": "0.1.944",
    "@tsconfig/recommended": "1.0.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "18.19.21",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@types/semver": "7.7.1",
    "jsdom": "22.1.0",
    "oxfmt": "^0.51.0",
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rimraf": "5.0.1",
    "typescript": "5.5.3",
    "vitest": "2.1.9"
  },
  "gitHead": "7c0206add0761d1ed8d623e11e9d9a0b9c010663"
}
