{
  "name": "@mintlify/common",
  "version": "1.0.1310",
  "description": "Commonly shared code within Mintlify",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server-mdx": {
      "types": "./dist/mdx/server-only/index.d.ts",
      "default": "./dist/mdx/server-only/index.js"
    },
    "./ssrf": {
      "types": "./dist/server-only/ssrf.d.ts",
      "default": "./dist/server-only/ssrf.js"
    },
    "./title-markdown": {
      "types": "./dist/mdx/titleMarkdown.d.ts",
      "default": "./dist/mdx/titleMarkdown.js"
    },
    "./parse-code-block-meta": {
      "types": "./dist/mdx/plugins/rehype/rehypeCodeBlocks/parseMetaString.d.ts",
      "default": "./dist/mdx/plugins/rehype/rehypeCodeBlocks/parseMetaString.js"
    },
    "./rehype-code-blocks": {
      "types": "./dist/mdx/plugins/rehype/rehypeCodeBlocks/index.d.ts",
      "default": "./dist/mdx/plugins/rehype/rehypeCodeBlocks/index.js"
    },
    "./css": {
      "types": "./dist/css/index.d.ts",
      "default": "./dist/css/index.js"
    },
    "./colors": {
      "types": "./dist/colors.d.ts",
      "default": "./dist/colors.js"
    },
    "./strip-markdown": {
      "types": "./dist/strip-markdown.d.ts",
      "default": "./dist/strip-markdown.js"
    },
    "./mulberry32": {
      "types": "./dist/mulberry32.d.ts",
      "default": "./dist/mulberry32.js"
    },
    "./parse-inline-style": {
      "types": "./dist/parse-inline-style.d.ts",
      "default": "./dist/parse-inline-style.js"
    },
    "./divisions/iterateObjectArrayProperty": {
      "types": "./dist/divisions/iterateObjectArrayProperty.d.ts",
      "default": "./dist/divisions/iterateObjectArrayProperty.js"
    },
    "./services/aws": {
      "types": "./dist/services/aws.d.ts",
      "default": "./dist/services/aws.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mintlify/mint",
    "directory": "packages/common"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsgo --project tsconfig.build.json",
    "clean:build": "rimraf dist",
    "clean:all": "rimraf node_modules .eslintcache && pnpm clean:build",
    "watch": "tsc --watch",
    "test": "vitest run",
    "type": "tsgo --noEmit && tsgo --noEmit --project bench",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "bench:scoped-nav": "node --expose-gc bench/scoped-nav/run.ts"
  },
  "author": "Mintlify, Inc.",
  "license": "ISC",
  "dependencies": {
    "@asyncapi/parser": "3.4.0",
    "@mintlify/mdx": "4.0.9",
    "@mintlify/models": "0.0.379",
    "@mintlify/openapi-parser": "0.0.9",
    "@mintlify/validation": "0.1.944",
    "@sindresorhus/slugify": "2.2.0",
    "@types/mdast": "4.0.4",
    "acorn": "8.11.2",
    "acorn-jsx": "5.3.2",
    "estree-util-to-js": "2.0.0",
    "estree-walker": "3.0.3",
    "front-matter": "4.0.2",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-estree": "3.1.0",
    "hast-util-to-html": "9.0.4",
    "ignore": "7.0.5",
    "iregexp-check": "0.1.2",
    "js-yaml": "4.3.1",
    "json-p3": "2.2.2",
    "lodash": "4.18.1",
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-gfm": "3.0.0",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-mdx-jsx": "3.1.3",
    "micromark": "4.0.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-gfm-table": "2.1.0",
    "micromark-extension-mdxjs": "3.0.0",
    "openapi-types": "12.1.3",
    "postcss": "8.5.23",
    "re2js": "2.8.6",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.0",
    "remark-math": "6.0.0",
    "remark-mdx": "3.1.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.1",
    "remark-smartypants": "3.0.2",
    "remark-stringify": "11.0.0",
    "sucrase": "3.34.0",
    "tailwindcss-v3": "npm:tailwindcss@3.4.17",
    "unified": "11.0.5",
    "unist-builder": "4.0.0",
    "unist-util-map": "4.0.0",
    "unist-util-remove": "4.0.0",
    "unist-util-remove-position": "5.0.0",
    "unist-util-visit": "5.0.0",
    "unist-util-visit-parents": "6.0.1",
    "valibot": "1.5.0",
    "vfile": "6.0.3",
    "xss": "1.0.15"
  },
  "devDependencies": {
    "@mintlify/openapi-types": "0.0.0",
    "@mintlify/ts-config": "2.0.2",
    "@tsconfig/recommended": "1.0.2",
    "@types/estree-jsx": "1.0.5",
    "@types/hast": "3.0.4",
    "@types/js-yaml": "4.0.9",
    "hast": "1.0.0",
    "openapi-types": "12.1.3",
    "oxfmt": "^0.51.0",
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "rimraf": "5.0.1",
    "typescript": "5.5.3",
    "vitest": "2.1.9"
  },
  "gitHead": "7c0206add0761d1ed8d623e11e9d9a0b9c010663"
}
