{
  "name": "@mintlify/cli",
  "version": "4.0.1747",
  "description": "The Mintlify CLI",
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Mintlify, Inc.",
  "bugs": {
    "url": "https://github.com/mintlify/docs/issues"
  },
  "license": "Elastic-2.0",
  "keywords": [
    "mintlify",
    "mint",
    "cli"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mintlify/mint",
    "directory": "packages/cli"
  },
  "exports": "./bin/index.js",
  "bin": {
    "mint": "bin/index.js",
    "mintlify": "bin/index.js"
  },
  "scripts": {
    "dev": "pnpm build && NODE_NO_WARNINGS=1 node bin/index.js",
    "prepack": "npm run build",
    "build": "tsc --project tsconfig.build.json && node scripts/bundle-converter.mjs",
    "clean:build": "rimraf bin",
    "clean:all": "rimraf node_modules .eslintcache && pnpm clean:build",
    "watch": "tsc --watch",
    "lint": "oxlint src",
    "test": "vitest run",
    "type": "tsgo --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@inquirer/prompts": "7.9.0",
    "@mintlify/common": "1.0.1310",
    "@mintlify/link-rot": "3.0.1543",
    "@mintlify/models": "0.0.379",
    "@mintlify/og": "0.0.109",
    "@mintlify/prebuild": "1.0.1479",
    "@mintlify/previewing": "4.0.1561",
    "@mintlify/validation": "0.1.944",
    "adm-zip": "0.6.0",
    "chalk": "5.2.0",
    "color": "4.2.3",
    "detect-port": "1.5.1",
    "fs-extra": "11.2.0",
    "ink": "6.3.0",
    "inquirer": "12.3.0",
    "js-yaml": "4.3.1",
    "katex": "0.16.47",
    "mdast-util-mdx-jsx": "3.2.0",
    "open": "8.4.2",
    "openid-client": "6.8.2",
    "posthog-node": "5.17.2",
    "prosemirror-model": "1.25.4",
    "react": "19.2.3",
    "remark": "15.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-mdx": "3.1.1",
    "remark-smartypants": "3.0.2",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "yaml": "2.8.3",
    "yargs": "17.7.1",
    "zod": "4.3.6"
  },
  "optionalDependencies": {
    "keytar": "7.9.0"
  },
  "devDependencies": {
    "@mintlify/editor": "0.0.583",
    "@mintlify/ts-config": "2.0.2",
    "@tsconfig/recommended": "1.0.2",
    "@types/detect-port": "1.3.2",
    "@types/keytar": "4.4.2",
    "@types/mdast": "4.0.4",
    "@types/node": "18.15.0",
    "@types/yargs": "17.0.22",
    "esbuild": "0.25.12",
    "openapi-types": "12.1.3",
    "oxfmt": "^0.51.0",
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "rimraf": "5.0.1",
    "sharp": "^0.33.1",
    "typescript": "5.5.3",
    "vitest": "2.1.9",
    "vitest-mock-process": "1.0.4"
  },
  "gitHead": "56c5bd31977d73c877d2a8364d34f971020c3d46"
}
