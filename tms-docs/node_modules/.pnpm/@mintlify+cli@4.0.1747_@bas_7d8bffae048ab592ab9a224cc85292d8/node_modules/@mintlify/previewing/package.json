{
  "name": "@mintlify/previewing",
  "version": "4.0.1561",
  "description": "Preview Mintlify docs locally",
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Mintlify, Inc.",
  "bugs": {
    "url": "https://github.com/mintlify/docs/issues"
  },
  "license": "Elastic-2.0",
  "keywords": [
    "mintlify",
    "mint",
    "previewing"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mintlify/mint",
    "directory": "packages/previewing"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "export-scripts"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc",
    "clean:build": "rimraf dist",
    "clean:all": "rimraf node_modules .eslintcache && pnpm clean:build",
    "watch": "tsc --watch",
    "format": "oxfmt \"./src/**/*.ts\"",
    "format:check": "oxfmt --check \"./src/**/*.ts\"",
    "lint": "oxlint .",
    "test": "vitest run",
    "type": "tsgo --noEmit"
  },
  "dependencies": {
    "@mintlify/common": "1.0.1310",
    "@mintlify/prebuild": "1.0.1479",
    "@mintlify/validation": "0.1.944",
    "adm-zip": "0.6.0",
    "better-opn": "3.0.2",
    "chalk": "5.2.0",
    "chokidar": "3.5.3",
    "express": "4.22.0",
    "fs-extra": "11.1.0",
    "got": "13.0.0",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-text": "4.0.0",
    "ink": "6.3.0",
    "ink-spinner": "5.0.0",
    "js-yaml": "4.3.1",
    "react": "19.2.3",
    "socket.io": "4.8.0",
    "tar": "7.5.21",
    "yargs": "17.7.1"
  },
  "optionalDependencies": {
    "@mintlify/package-builder": "0.0.99"
  },
  "devDependencies": {
    "@mintlify/models": "0.0.379",
    "@mintlify/ts-config": "2.0.2",
    "@tsconfig/recommended": "1.0.2",
    "@types/express": "4.17.21",
    "@types/fs-extra": "9.0.13",
    "@types/got": "9.6.12",
    "@types/hast": "3.0.4",
    "@types/inquirer": "9.0.3",
    "@types/mdast": "4.0.4",
    "@types/node": "18.19.21",
    "@types/tar": "6.1.5",
    "@types/yargs": "17.0.22",
    "oxfmt": "^0.51.0",
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "rimraf": "5.0.1",
    "typescript": "5.5.3",
    "vitest": "2.1.9",
    "vitest-mock-process": "1.0.4"
  },
  "gitHead": "56c5bd31977d73c877d2a8364d34f971020c3d46"
}
