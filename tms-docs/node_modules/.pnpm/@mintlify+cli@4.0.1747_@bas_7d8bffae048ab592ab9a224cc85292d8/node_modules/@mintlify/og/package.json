{
  "name": "@mintlify/og",
  "version": "0.0.109",
  "description": "Renders Mintlify social preview (Open Graph) cards",
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Mintlify, Inc.",
  "bugs": {
    "url": "https://github.com/mintlify/docs/issues"
  },
  "license": "Elastic-2.0",
  "keywords": [
    "mintlify",
    "og",
    "open-graph"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mintlify/mint",
    "directory": "packages/og"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./layouts": {
      "types": "./dist/layouts/index.d.ts",
      "default": "./dist/layouts/index.js"
    },
    "./theme": {
      "types": "./dist/inputs/theme.d.ts",
      "default": "./dist/inputs/theme.js"
    },
    "./content": {
      "types": "./dist/inputs/content.d.ts",
      "default": "./dist/inputs/content.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./font-urls": {
      "types": "./dist/inputs/default-font-urls.d.ts",
      "default": "./dist/inputs/default-font-urls.js"
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "test": "vitest run",
    "type": "tsgo --noEmit",
    "prepack": "npm run build",
    "build": "tsc --project tsconfig.build.json",
    "clean:build": "rimraf dist",
    "clean:all": "rimraf node_modules .eslintcache && pnpm clean:build",
    "watch": "tsc --watch",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@mintlify/common": "1.0.1310",
    "@mintlify/validation": "0.1.944",
    "@resvg/resvg-wasm": "2.6.2",
    "@shuding/opentype.js": "1.4.0-beta.0",
    "image-size": "2.0.2",
    "react": "19.2.3",
    "satori": "0.33.5"
  },
  "devDependencies": {
    "@mintlify/ts-config": "2.0.2",
    "@tsconfig/recommended": "1.0.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.1",
    "oxfmt": "^0.51.0",
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "rimraf": "5.0.1",
    "typescript": "5.5.3",
    "vitest": "2.1.9"
  },
  "gitHead": "7c0206add0761d1ed8d623e11e9d9a0b9c010663"
}
