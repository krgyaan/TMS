    "mock-fs": "5.2.0",
    "openapi-types": "12.1.3",
    "oxfmt": "^0.51.0",
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "rimraf": "5.0.1",
    "typescript": "5.5.3",
    "vitest": "2.1.9"
