{
  "name": "@mintlify/prebuild",
  "type": "module",
  "version": "1.0.1479",
  "description": "Helpful functions for Mintlify's prebuild step",
  "author": "Mintlify, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mintlify/mint",
    "directory": "packages/prebuild"
  },
  "bugs": {
    "url": "https://github.com/mintlify/mint/issues"
  },
  "license": "Elastic-2.0",
  "keywords": [
    "mintlify",
    "mint",
    "prebuild"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc --project tsconfig.build.json",
    "clean:build": "rimraf dist",
    "clean:all": "rimraf node_modules .eslintcache && pnpm clean:build",
    "watch": "tsc --project tsconfig.build.json --watch",
    "lint": "oxlint .",
    "test": "vitest run",
    "type": "tsgo --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@mintlify/common": "1.0.1310",
    "@mintlify/scraping": "4.0.1186",
    "@mintlify/validation": "0.1.944",
    "chalk": "5.3.0",
    "favicons": "7.2.0",
    "fflate": "0.8.2",
    "fs-extra": "11.1.0",
    "js-yaml": "4.3.1",
    "openapi-types": "12.1.3",
    "sharp": "0.33.5",
    "sharp-ico": "0.1.5",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@mintlify/models": "0.0.379",
    "@mintlify/ts-config": "2.0.2",
    "@tsconfig/recommended": "1.0.2",
    "@types/mdast": "4.0.4",
    "@types/node": "18.15.10",
    "oxfmt": "^0.51.0",
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "rimraf": "5.0.1",
    "typescript": "5.5.3",
    "vitest": "2.1.9"
  },
  "gitHead": "56c5bd31977d73c877d2a8364d34f971020c3d46"
}
