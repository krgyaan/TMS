        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "editorMode": "code",
          "expr": "{service_name=\"volksAi\"} | json",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "VolksAI Live Logs (Tail)",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 200,
      "title": "AI Auto-Extract Save Lifecycle & Token Guard",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "description": "Flags failed or missing extraction saves within a 5-minute rolling window. If > 0, inspect the save flow panel below.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=~\"tms-api|tms-worker\"} | json | event_type=\"autoextract_save\" and (action=\"save_failure\" or action=\"missing_save\")[5m])) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Failed / Missing Saves (Last 5m)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "description": "Total extractions completed vs saves verified",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 14
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "editorMode": "code",
          "expr": "sum by (action) (count_over_time({job=~\"tms-api|tms-worker\"} | json | event_type=\"autoextract_save\"[5m]))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Auto-Extract Events by Action (5m window)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "description": "Detailed log trace of the AI autoextract save lifecycle: extraction_started, extraction_result_received, save_request_sent, save_success, followup_check",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "editorMode": "code",
          "expr": "{job=~\"tms-api|tms-worker|volksAi\"} | json | event_type=\"autoextract_save\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Auto-Extract Save Flow Trace Logs",
      "type": "logs"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
