# ==============================================================================
# VolksAI Microservice Environment Configuration
# ==============================================================================

# --- LLM Fallback & Layer 2 Resolution Configuration ---
# Enables or disables Layer 2 LLM resolution for missing/ambiguous BEC fields
LLM_FALLBACK_ENABLED=true

# Provider preference: anthropic | groq | gemini (auto-detected if blank)
LLM_PROVIDER=anthropic

# Anthropic Claude Configuration (Primary Provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Generic OpenAI-compatible / Groq Configuration (Secondary Fallback)
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
LLM_SCHEMA_MODEL=gemini-flash-lite-latest

# LLM Execution Tuning (2 attempts total = 1 initial try + 1 retry on transient failure)
LLM_MAX_RETRIES=2
LLM_MAX_EXAMPLES_PER_FIELD=5

# --- OCR Engine Configuration ---
# Set to 'false' to disable PaddleOCR and force Tesseract-only engine
PADDLE_OCR_ENABLED=true

# PaddlePaddle CPU Tuning (stops core monopolization in Docker/FastAPI)
OMP_NUM_THREADS=1
FLAGS_allocator_strategy=naive_best_fit

# --- Pipeline Execution Flags ---
# Set to 'true' to disable outbound network requests during hyperlink verification
OFFLINE_EXTRACTION=false
